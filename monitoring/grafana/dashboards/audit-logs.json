{
  "uid": "audit-logs",
  "title": "Audit Logs",
  "tags": ["simple-trade"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "description": "审计日志仪表盘（数据源 Loki）。注意：审计事件实际经 Kafka 由 log-service 写入 PostgreSQL audit_logs 表；Loki 中仅能采集到审计相关日志行（写操作请求日志 / 审计发布失败告警）。按用户/操作详情的精确查询建议使用 PostgreSQL-AuditLogs 数据源。",
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "iconColor": "rgba(0, 211, 255, 1)",
        "enable": true,
        "showIn": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "审计事件时间线",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "description": "含 \"audit\" 关键字的日志行计数随时间变化。Loki job 标签为 simple_trade（来自 promtail job_name）。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"simple_trade\"} |= \"audit\" [$__interval]))",
          "legendFormat": "audit 日志行",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"simple_trade\", container_name=\"simple_trade_gateway\"} | regexp \"\\\"method\\\":\\\"(?P<method>POST|PUT|DELETE|PATCH)\\\"\" [$__interval]))",
          "legendFormat": "写操作请求",
          "queryType": "instant",
          "hide": false
        }
      ]
    },
    {
      "id": 2,
      "title": "按操作类型分布 (POST/PUT/DELETE)",
      "type": "piechart",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "description": "写操作请求按 HTTP 方法分布（从网关请求日志解析）。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "combine": { "threshold": 0, "label": "Others" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (method) (count_over_time({job=\"simple_trade\", container_name=\"simple_trade_gateway\"} | regexp \"\\\"method\\\":\\\"(?P<method>POST|PUT|DELETE|PATCH)\\\"\" [5m]))",
          "legendFormat": "{{method}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "title": "按用户分布 (按 request_id 近似)",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "description": "Loki 日志不含 user_id（审计中间件仅将 user_id 发布到 Kafka）。此处按 request_id 标签近似展示请求分布；按真实用户分布请使用 PostgreSQL-AuditLogs 数据源查询 audit_logs.user_id。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(10, sum by (request_id) (count_over_time({job=\"simple_trade\", container_name=\"simple_trade_gateway\", request_id!=\"\"} [5m])))",
          "legendFormat": "{{request_id}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "title": "错误操作统计 (审计发布失败)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "description": "审计日志发布失败次数（匹配 \"Failed to publish audit log\" 告警行）。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"simple_trade\"} |= \"audit\" |= \"Failed\" [5m]))",
          "legendFormat": "发布失败",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "title": "审计事件详情",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "description": "最近的审计相关日志行（含 \"audit\" 关键字）。",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Line" },
            "properties": [{ "id": "custom.width", "value": 1000 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false },
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"simple_trade\"} |= \"audit\"",
          "queryType": "instant",
          "maxLines": 100
        }
      ]
    }
  ]
}
