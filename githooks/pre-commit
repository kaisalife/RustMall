#!/bin/bash
# pre-commit hook: git commit 时自动运行本地 CI 检查
# 检查项：代码格式 -> Clippy 静态分析 -> 单元测试

set -e

echo "=========================================="
echo "  Running local CI checks (pre-commit)    "
echo "=========================================="

# 只检查有变更的 Rust 文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "No Rust files staged, skipping checks."
    exit 0
fi

echo "Staged Rust files:"
echo "$STAGED_FILES"
echo ""

# 1. 代码格式检查
echo "--- [1/3] cargo fmt --check ---"
if ! cargo fmt --all -- --check; then
    echo ""
    echo "FORMAT CHECK FAILED!"
    echo "Run 'cargo fmt --all' to fix formatting, then re-stage and commit."
    exit 1
fi
echo "Format check passed."
echo ""

# 2. Clippy 静态分析（只检查 workspace，不检查 tests 以加速）
echo "--- [2/3] cargo clippy ---"
if ! cargo clippy --workspace -- -D warnings 2>&1; then
    echo ""
    echo "CLIPPY FAILED!"
    echo "Fix the warnings above, then re-commit."
    exit 1
fi
echo "Clippy check passed."
echo ""

# 3. 单元测试（快速模式：跳过需要外部依赖的 #[ignore] 测试）
echo "--- [3/3] cargo test ---"
if ! cargo test --workspace 2>&1; then
    echo ""
    echo "TESTS FAILED!"
    echo "Fix the failing tests, then re-commit."
    exit 1
fi
echo "All tests passed."
echo ""

echo "=========================================="
echo "  All CI checks passed! Commiting...      "
echo "=========================================="
exit 0
